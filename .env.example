# Copy to .env. Do not commit .env.

# BPOM database via SSH tunnel (localhost:5533 → remote postgres:5433)
# WAREHOUSE_URL=postgresql://readonly_user:<password>@localhost:5533/rpo_v2

# LLM provider — set one of these:
# GOOGLE_API_KEY=...
# OPENAI_API_KEY=...
# SEEKNAL_ASK_LLM_PROVIDER=google
# SEEKNAL_ASK_MODEL=gemini-2.0-flash
# TEST_DATA_VERSION=v1
